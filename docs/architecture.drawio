        <mxCell id="L1s" value="① TRÌNH BÀY" style="rounded=0;whiteSpace=wrap;html=1;horizontal=0;fontSize=12;fontStyle=1;fillColor=#b9d1f0;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="122" width="34" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="A1" value="&lt;b&gt;Ứng dụng làm sạch dữ liệu&lt;/b&gt; – dashboard/app.py (Streamlit)&lt;br&gt;Trang: Nạp tệp [UC1, UC3] · Cặp nghi trùng [UC4, UC5] · Cấu hình quy tắc [UC6] · Xuất hồ sơ lỗi [UC9]&lt;br&gt;&lt;i&gt;Trách nhiệm:&lt;/i&gt; nhận thao tác, kiểm tra nhập liệu, hiển thị kết quả do ② trả về (số điện thoại đã che theo vai trò); không chứa quy tắc nghiệp vụ." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="44" y="146" width="452" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="A2" value="&lt;b&gt;Dashboard mức độ sạch&lt;/b&gt; [UC8]&lt;br&gt;dashboard/report.py (Streamlit)&lt;br&gt;K1 Tổng quan · K2 Theo quy tắc · K3 Cặp nghi trùng&lt;br&gt;&lt;i&gt;Trách nhiệm:&lt;/i&gt; trực quan hóa; lọc theo đơn vị nguồn của người xem (QT-14); chỉ đọc." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="508" y="146" width="280" height="100" as="geometry"/>
