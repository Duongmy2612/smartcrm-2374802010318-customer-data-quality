          <mxGeometry x="0" y="300" width="800" height="236" as="geometry"/>
        </mxCell>
        <mxCell id="L2s" value="② XỬ LÝ – NGHIỆP VỤ" style="rounded=0;whiteSpace=wrap;html=1;horizontal=0;fontSize=12;fontStyle=1;fillColor=#b3d6b0;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="0" y="300" width="34" height="236" as="geometry"/>
        </mxCell>
        <mxCell id="L2n" value="&lt;i&gt;thư mục src/etl/ · Python (pandas, rapidfuzz) · mũi tên mảnh = thứ tự gọi chính; trình tự đầy đủ theo từng use case ở Bảng 3.1&lt;/i&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="44" y="302" width="744" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="B1" value="&lt;b&gt;extract.py&lt;/b&gt;&lt;br&gt;&lt;i&gt;FR-01&lt;/i&gt;&lt;br&gt;Đọc tệp, kiểm cột bắt buộc ho_ten, so_dien_thoai, băm SHA-256; ghi đợt nạp và hồ sơ thô." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="44" y="326" width="185" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="B2" value="&lt;b&gt;transform.py&lt;/b&gt;&lt;br&gt;&lt;i&gt;FR-02, FR-03, FR-10&lt;/i&gt;&lt;br&gt;Chuẩn hóa số điện thoại (QT-02), họ tên; gắn mã lỗi; đưa hồ sơ hợp lệ vào customer_clean; xuất CSV hồ sơ lỗi." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="249" y="326" width="185" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="B3" value="&lt;b&gt;match.py&lt;/b&gt;&lt;br&gt;&lt;i&gt;FR-04&lt;/i&gt;&lt;br&gt;Tạo name_key; blocking 5 số đầu / 5 số cuối; chấm điểm (QL7-03); sinh cặp nghi trùng (QL7-02, QL7-05)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="454" y="326" width="185" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="B4" value="&lt;b&gt;merge_service.py&lt;/b&gt;&lt;br&gt;&lt;i&gt;FR-05, FR-06, FR-11&lt;/i&gt;&lt;br&gt;Danh sách cặp, che số theo vai trò (QT-15); Gộp / Giữ riêng trong một giao dịch (QT-01, QT-13, QL7-01, QL7-07)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="44" y="432" width="185" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="B5" value="&lt;b&gt;dq_evaluate.py&lt;/b&gt;&lt;br&gt;&lt;i&gt;FR-07, FR-08&lt;/i&gt;&lt;br&gt;Lưu cấu hình quy tắc (tổng trọng số = 1,00); đo DQ-01..06, ghi dq_result (QL7-06)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;" vertex="1" parent="1">
          <mxGeometry x="249" y="432" width="185" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="B6" value="&lt;b&gt;load_dwh.py&lt;/b&gt;&lt;br&gt;&lt;i&gt;FR-09&lt;/i&gt;&lt;br&gt;Nạp dim/fact vào dwh, SCD loại 2 cho dim_rule; chạy sau mỗi lần phát hiện cặp, đo và lưu cấu hình." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=3;" vertex="1" parent="1">
