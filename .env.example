# Mẫu biến môi trường – chép thành .env rồi điền (README mục 3, bước 6). .env KHÔNG commit (NFR-07).
# Giá trị dưới đây là giá trị mẫu, không phải giá trị thật.

# Database (PostgreSQL – schema ops và dwh)
# PostgreSQL cài bằng Homebrew (macOS): để trống DB_USER và DB_PASSWORD – hệ thống dùng tài khoản macOS đang đăng nhập.
# PostgreSQL có tài khoản/mật khẩu riêng (ví dụ postgres): điền vào hai dòng dưới.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=
DB_PASSWORD=

# CSDL riêng cho kiểm thử tích hợp (tests/conftest.py) – mỗi test xóa và tạo lại schema trong CSDL này,
# không đụng tới DB_NAME. Để trống thì dùng smartcrm_test.
DB_NAME_TEST=smartcrm_test

# Dashboard (dashboard/report.py) – tài khoản RIÊNG, chỉ đọc kho dwh (BT3: BUG-16, TD-36).
# Luồng chính (python -m src.pipeline) tự tạo tài khoản này và cấp quyền: SELECT trên schema dwh (chỉ có số đếm),
# KHÔNG có quyền gì trên schema ops (có họ tên, số điện thoại). Bắt buộc – để trống thì dashboard báo thiếu cấu hình.
# Mật khẩu dưới đây là giá trị MẪU cho máy cá nhân / Docker; triển khai thật thì đổi.
DASH_DB_USER=dash_reader
DASH_DB_PASSWORD=dash_reader_mau_doi_khi_trien_khai

# Cổng dashboard không đặt ở đây: .streamlit/config.toml (8501), đổi tạm bằng --server.port.
